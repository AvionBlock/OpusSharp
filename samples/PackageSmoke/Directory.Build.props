<Project>
  <Import Project="..\..\Directory.Build.props" />

  <PropertyGroup>
    <OpusSharpSmokeVersion>$(OpusSharpVersion)</OpusSharpSmokeVersion>
    <_OpusSharpSmokeLocalNuGet>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'local-nuget'))</_OpusSharpSmokeLocalNuGet>
    <RestoreSources>$(_OpusSharpSmokeLocalNuGet);https://api.nuget.org/v3/index.json</RestoreSources>
  </PropertyGroup>
</Project>

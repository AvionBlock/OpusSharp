<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-browser</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WasmMainHTMLPath>wwwroot/index.html</WasmMainHTMLPath>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <EmccCompileOptimizationFlag>-O0</EmccCompileOptimizationFlag>
    <EmccLinkOptimizationFlag>-O0</EmccLinkOptimizationFlag>
    <WasmBitcodeCompileOptimizationFlag>-O0</WasmBitcodeCompileOptimizationFlag>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpusSharp" Version="$(OpusSharpSmokeVersion)" />
  </ItemGroup>
</Project>
